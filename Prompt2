LIGHT_COLOR_PALETTE = ["#0284C7", "#0D9488", "#6366F1", "#8B5CF6", "#EC4899", "#F59E0B", "#10B981", "#64748B"]


def apply_plotly_light_theme(fig: go.Figure, title: str) -> go.Figure:
    """Applies clean, unified light enterprise aesthetics to Plotly charts."""
    fig.update_layout(
        title={"text": f"<b>{title}</b>", "font": {"size": 13, "color": "#0F172A"}},
        margin=dict(l=20, r=20, t=45, b=20),
        paper_bgcolor="#FFFFFF",
        plot_bgcolor="#FFFFFF",
        font=dict(family="Inter, sans-serif", color="#475569", size=11),
        legend=dict(
            orientation="h",
            yanchor="bottom",
            y=1.02,
            xanchor="right",
            x=1,
            title="",
            font=dict(size=10),
        ),
        xaxis=dict(
            showgrid=True,
            gridcolor="#F1F5F9",
            zeroline=False,
            showline=True,
            linecolor="#CBD5E1",
            tickfont=dict(size=10),
        ),
        yaxis=dict(
            showgrid=True,
            gridcolor="#F1F5F9",
            zeroline=False,
            showline=True,
            linecolor="#CBD5E1",
            tickfont=dict(size=10),
        ),
    )
    return fig


def build_categorical_bar(df: pd.DataFrame, col: str, title: str) -> go.Figure:
    counts = df[col].astype(str).value_counts().reset_index()
    counts.columns = [col, "Count"]
    counts = counts.head(12)

    fig = px.bar(
        counts,
        x="Count",
        y=col,
        orientation="h",
        text="Count",
        color_discrete_sequence=["#0284C7"],
    )
    fig.update_traces(textposition="outside", marker_line_color="#0284C7", marker_line_width=1)
    fig.update_layout(yaxis=dict(autorange="reversed"))
    return apply_plotly_light_theme(fig, title)


def build_categorical_donut(df: pd.DataFrame, col: str, title: str) -> go.Figure:
    counts = df[col].astype(str).value_counts().reset_index()
    counts.columns = [col, "Count"]
    if len(counts) > 6:
        top_5 = counts.iloc[:5]
        other_cnt = counts.iloc[5:]["Count"].sum()
        counts = pd.concat(
            [top_5, pd.DataFrame([{col: "Other", "Count": other_cnt}])],
            ignore_index=True,
        )

    fig = px.pie(
        counts,
        names=col,
        values="Count",
        hole=0.55,
        color_discrete_sequence=LIGHT_COLOR_PALETTE,
    )
    fig.update_traces(textinfo="percent+label", textposition="inside")
    return apply_plotly_light_theme(fig, title)


def build_date_trend(
    df: pd.DataFrame, date_col: str, cat_col: str | None, title: str
) -> go.Figure:
    temp_df = df.copy()
    temp_df[date_col] = pd.to_datetime(temp_df[date_col], errors="coerce")
    temp_df = temp_df.dropna(subset=[date_col])

    if temp_df.empty:
        fig = go.Figure()
        fig.add_annotation(text="No valid date data available", showarrow=False)
        return apply_plotly_light_theme(fig, title)

    min_d, max_d = temp_df[date_col].min(), temp_df[date_col].max()
    days_span = (max_d - min_d).days

    if days_span <= 30:
        freq, freq_label = "D", "Daily"
    elif days_span <= 180:
        freq, freq_label = "W-MON", "Weekly"
    elif days_span <= 730:
        freq, freq_label = "ME", "Monthly"
    else:
        freq, freq_label = "YE", "Yearly"

    if cat_col and temp_df[cat_col].nunique() <= 6:
        grouped = (
            temp_df.groupby([pd.Grouper(key=date_col, freq=freq), cat_col], observed=False)
            .size()
            .reset_index(name="Count")
        )
        fig = px.line(
            grouped,
            x=date_col,
            y="Count",
            color=cat_col,
            markers=True,
            color_discrete_sequence=LIGHT_COLOR_PALETTE,
        )
    else:
        grouped = (
            temp_df.groupby(pd.Grouper(key=date_col, freq=freq), observed=False)
            .size()
            .reset_index(name="Count")
        )
        fig = px.area(
            grouped,
            x=date_col,
            y="Count",
            markers=True,
            color_discrete_sequence=["#0284C7"],
        )
        fig.update_traces(fillcolor="rgba(2, 132, 199, 0.08)", line_width=2)

    return apply_plotly_light_theme(fig, f"{title} ({freq_label})")


def build_cumulative_trend(df: pd.DataFrame, date_col: str, title: str) -> go.Figure:
    temp_df = df.copy()
    temp_df[date_col] = pd.to_datetime(temp_df[date_col], errors="coerce")
    temp_df = temp_df.dropna(subset=[date_col]).sort_values(by=date_col)

    if temp_df.empty:
        fig = go.Figure()
        fig.add_annotation(text="No valid date data available", showarrow=False)
        return apply_plotly_light_theme(fig, title)

    grouped = temp_df.groupby(pd.Grouper(key=date_col, freq="D")).size().reset_index(name="DailyCount")
    grouped["Cumulative"] = grouped["DailyCount"].cumsum()

    fig = px.line(
        grouped,
        x=date_col,
        y="Cumulative",
        color_discrete_sequence=["#0D9488"],
    )
    fig.update_traces(line_width=2.5)
    return apply_plotly_light_theme(fig, title)


def build_pareto_cat(df: pd.DataFrame, col: str, title: str) -> go.Figure:
    counts = df[col].astype(str).value_counts().reset_index()
    counts.columns = [col, "Count"]
    counts = counts.head(10)
    counts["CumSum"] = counts["Count"].cumsum()
    counts["CumPct"] = (counts["CumSum"] / counts["Count"].sum()) * 100

    fig = go.Figure()
    fig.add_trace(
        go.Bar(
            x=counts[col],
            y=counts["Count"],
            name="Count",
            marker_color="#0284C7",
        )
    )
    fig.add_trace(
        go.Scatter(
            x=counts[col],
            y=counts["CumPct"],
            name="Cumulative %",
            yaxis="y2",
            mode="lines+markers",
            line=dict(color="#EC4899", width=2),
        )
    )

    fig.update_layout(
        yaxis2=dict(
            title="Cumulative %",
            overlaying="y",
            side="right",
            range=[0, 105],
            showgrid=False,
        )
    )
    return apply_plotly_light_theme(fig, title)


def build_num_by_cat(df: pd.DataFrame, num_col: str, cat_col: str, title: str) -> go.Figure:
    temp_df = df.copy()
    temp_df[num_col] = pd.to_numeric(temp_df[num_col], errors="coerce")
    grouped = (
        temp_df.groupby(cat_col, observed=False)[num_col]
        .sum()
        .reset_index()
        .sort_values(by=num_col, ascending=False)
        .head(10)
    )
    fig = px.bar(
        grouped,
        x=cat_col,
        y=num_col,
        text_auto=".2s",
        color_discrete_sequence=["#0D9488"],
    )
    fig.update_traces(textposition="outside")
    return apply_plotly_light_theme(fig, title)


def build_num_distribution(df: pd.DataFrame, num_col: str, title: str) -> go.Figure:
    clean_series = pd.to_numeric(df[num_col], errors="coerce").dropna()
    fig = px.histogram(
        clean_series,
        x=num_col,
        nbins=25,
        marginal="box",
        color_discrete_sequence=["#6366F1"],
    )
    return apply_plotly_light_theme(fig, title)


def build_scatter_num(
    df: pd.DataFrame, num_x: str, num_y: str, cat_col: str | None, title: str
) -> go.Figure:
    temp_df = df.copy()
    temp_df[num_x] = pd.to_numeric(temp_df[num_x], errors="coerce")
    temp_df[num_y] = pd.to_numeric(temp_df[num_y], errors="coerce")
    temp_df = temp_df.dropna(subset=[num_x, num_y])

    if cat_col and temp_df[cat_col].nunique() <= 8:
        fig = px.scatter(
            temp_df,
            x=num_x,
            y=num_y,
            color=cat_col,
            opacity=0.75,
            color_discrete_sequence=LIGHT_COLOR_PALETTE,
        )
    else:
        fig = px.scatter(
            temp_df,
            x=num_x,
            y=num_y,
            opacity=0.75,
            color_discrete_sequence=["#0284C7"],
        )

    return apply_plotly_light_theme(fig, title)


# ==============================================================================
# 7. EXCEL REPORT GENERATOR
# ==============================================================================
def generate_excel_kpi_report(
    df: pd.DataFrame, classifications: dict[str, list[str]], quality: dict
) -> bytes:
    """Generates a professional multi-sheet Excel workbook cleanly styled in light tones."""
    output = BytesIO()
    wb = openpyxl.Workbook()

    font_header = Font(name="Calibri", size=11, bold=True, color="FFFFFF")
    font_title = Font(name="Calibri", size=15, bold=True, color="0F172A")
    fill_slate = PatternFill(start_color="334155", end_color="334155", fill_type="solid")
    thin_border = Border(
        left=Side(style="thin", color="CBD5E1"),
        right=Side(style="thin", color="CBD5E1"),
        top=Side(style="thin", color="CBD5E1"),
        bottom=Side(style="thin", color="CBD5E1"),
    )

    # Sheet 1: Overview
    ws_ov = wb.active
    ws_ov.title = "Executive Overview"
    ws_ov.views.sheetView[0].showGridLines = True
    ws_ov["A1"] = "ENTERPRISE KPI & DATA QUALITY SUMMARY"
    ws_ov["A1"].font = font_title

    ov_metrics = [
        ("Total Record Count", quality["total_rows"]),
        ("Total Features / Columns", quality["total_cols"]),
        ("Overall Data Quality Score", f"{quality['overall_quality']}%"),
        ("Completeness Score", f"{quality['completeness_score']}%"),
        ("Duplicate Row Count", quality["duplicate_rows"]),
        ("Date Fields Detected", len(classifications["DATE"])),
        ("Categorical Fields Detected", len(classifications["CATEGORICAL"])),
        ("Numeric Fields Detected", len(classifications["NUMERIC"])),
    ]

    ws_ov.cell(row=3, column=1, value="Metric").font = font_header
    ws_ov.cell(row=3, column=1).fill = fill_slate
    ws_ov.cell(row=3, column=2, value="Value").font = font_header
    ws_ov.cell(row=3, column=2).fill = fill_slate

    for idx, (m, v) in enumerate(ov_metrics, start=4):
        ws_ov.cell(row=idx, column=1, value=m).border = thin_border
        cell_v = ws_ov.cell(row=idx, column=2, value=str(v))
        cell_v.border = thin_border
        cell_v.alignment = Alignment(horizontal="right")

    # Sheet 2: Data Quality Audit
    ws_dq = wb.create_sheet(title="Data Quality Audit")
    ws_dq.views.sheetView[0].showGridLines = True
    dq_df = quality["column_stats"]

    for col_num, header in enumerate(dq_df.columns, 1):
        c = ws_dq.cell(row=1, column=col_num, value=header)
        c.font = font_header
        c.fill = fill_slate

    for r_idx, row in enumerate(dq_df.itertuples(index=False), 2):
        for c_idx, val in enumerate(row, 1):
            c = ws_dq.cell(row=r_idx, column=c_idx, value=str(val) if pd.isna(val) else val)
            c.border = thin_border

    # Sheet 3: Numeric Summary
    if classifications["NUMERIC"]:
        ws_num = wb.create_sheet(title="Numeric Analytics")
        ws_num.views.sheetView[0].showGridLines = True
        num_cols_clean = [c for c in classifications["NUMERIC"] if c in df.columns]
        if num_cols_clean:
            num_summary = df[num_cols_clean].apply(pd.to_numeric, errors="coerce").describe().T.reset_index()
            num_summary.rename(columns={"index": "Numeric Column"}, inplace=True)

            for col_num, header in enumerate(num_summary.columns, 1):
                c = ws_num.cell(row=1, column=col_num, value=header)
                c.font = font_header
                c.fill = fill_slate

            for r_idx, row in enumerate(num_summary.itertuples(index=False), 2):
                for c_idx, val in enumerate(row, 1):
                    c = ws_num.cell(
                        row=r_idx,
                        column=c_idx,
                        value=round(val, 2) if isinstance(val, (float, np.floating)) else str(val),
                    )
                    c.border = thin_border

    # Sheet 4: Export Data Sample
    ws_data = wb.create_sheet(title="Data Export")
    ws_data.views.sheetView[0].showGridLines = True
    export_sample = df.head(5000)

    for col_num, header in enumerate(export_sample.columns, 1):
        c = ws_data.cell(row=1, column=col_num, value=header)
        c.font = font_header
        c.fill = fill_slate

    for r_idx, row in enumerate(export_sample.itertuples(index=False), 2):
        for c_idx, val in enumerate(row, 1):
            cell_val = str(val) if (pd.isna(val) or isinstance(val, (list, dict))) else val
            c = ws_data.cell(row=r_idx, column=c_idx, value=cell_val)
            c.border = thin_border

    # Auto-fit Column Widths
    for ws in wb.worksheets:
        for col in ws.columns:
            max_len = max(len(str(cell.value or "")) for cell in col)
            col_letter = get_column_letter(col[0].column)
            ws.column_dimensions[col_letter].width = min(max(max_len + 3, 12), 40)

    wb.save(output)
    return output.getvalue()


