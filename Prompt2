                        "Value": [
                            f"{s.sum():,.2f}" if not s.empty else "0.00",
                            f"{s.mean():,.2f}" if not s.empty else "0.00",
                            f"{s.median():,.2f}" if not s.empty else "0.00",
                            f"{s.std():,.2f}" if not s.empty else "0.00",
                            f"{s.min():,.2f}" if not s.empty else "0.00",
                            f"{s.max():,.2f}" if not s.empty else "0.00",
