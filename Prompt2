# 2. DATA INGESTION & CLEANING
# ==============================================================================
@st.cache_data(show_spinner=False)
def load_and_clean_data(
    file_bytes: bytes, file_name: str, sheet_name: str | None = None
) -> tuple[pd.DataFrame | None, str | None]:
    """Reads Excel or CSV files, cleans column names, drops empty rows/cols."""
    try:
        buffer = BytesIO(file_bytes)
        if file_name.endswith((".xlsx", ".xls")):
            if sheet_name:
                df = pd.read_excel(buffer, sheet_name=sheet_name)
            else:
                xl = pd.ExcelFile(buffer)
                sheet_name = xl.sheet_names[0]
                df = pd.read_excel(buffer, sheet_name=sheet_name)
        else:
            df = pd.read_csv(buffer)

        if df.empty:
            return None, "Uploaded file/worksheet contains no data."

        # Clean Columns
        df.columns = [str(col).strip() for col in df.columns]

        # Drop completely empty rows and columns
        df = df.dropna(how="all").dropna(axis=1, how="all")

        if df.empty:
            return None, "Dataset became empty after dropping fully blank rows/columns."

        return df, None
    except Exception as e:
        return None, f"Error processing file: {str(e)}"


# ==============================================================================
# 3. GENERIC COLUMN CLASSIFICATION ENGINE
# ==============================================================================
def classify_columns(df: pd.DataFrame) -> dict[str, list[str]]:
    """Generic detection engine classifying columns into ID, DATE, CATEGORICAL, NUMERIC, and TEXT."""
    classifications: dict[str, list[str]] = {
        "ID": [],
        "DATE": [],
        "CATEGORICAL": [],
        "NUMERIC": [],
        "TEXT": [],
    }

    id_keywords = ["id", "key", "identifier", "code", "num", "number", "ref", "uuid", "guid", "pk", "fk"]

    for col in df.columns:
        series = df[col].dropna()
        col_lower = str(col).lower()
        total_len = len(df[col])
        non_null_len = len(series)

        if non_null_len == 0:
            classifications["TEXT"].append(col)
            continue

        n_unique = series.nunique()
        uniqueness_ratio = n_unique / non_null_len

        # 1. DATE DETECTION
        is_date = False
        if pd.api.types.is_datetime64_any_dtype(series):
            is_date = True
        elif series.dtype == "object" or pd.api.types.is_string_dtype(series):
            # Check string dates without raising exceptions
            sample = series.astype(str).str.strip().head(100)
            date_matches = 0
            for val in sample:
                if len(val) >= 6 and re.search(r"\d{2,4}[-/\.]\d{1,2}[-/\.]\d{1,2}", val):
                    date_matches += 1
            if date_matches / len(sample) > 0.6:
                try:
                    pd.to_datetime(series.head(50), format="mixed", errors="raise")
                    is_date = True
                except (ValueError, TypeError):
                    pass

        if is_date:
            classifications["DATE"].append(col)
            continue

        # 2. ID DETECTION
        has_id_keyword = any(kw in col_lower for kw in id_keywords)
        if uniqueness_ratio > 0.95 and total_len > 10:
            if has_id_keyword or series.dtype == "object":
                classifications["ID"].append(col)
                continue
        elif has_id_keyword and uniqueness_ratio > 0.7:
            classifications["ID"].append(col)
            continue

        # 3. NUMERIC DETECTION
        if pd.api.types.is_numeric_dtype(series):
            # Treat numeric with tiny integer range as categorical if low cardinality
            if n_unique <= 10 and (n_unique / non_null_len) < 0.05:
                classifications["CATEGORICAL"].append(col)
            else:
                classifications["NUMERIC"].append(col)
            continue

        # Attempt string-to-numeric coercion check
        if series.dtype == "object":
            sample_str = series.astype(str).str.replace(",", "").str.replace("$", "").str.strip()
            numeric_coerced = pd.to_numeric(sample_str, errors="coerce")
            if numeric_coerced.notnull().sum() / non_null_len > 0.85:
                classifications["NUMERIC"].append(col)
                continue

        # 4. CATEGORICAL VS TEXT
        avg_str_len = series.astype(str).str.len().mean()
        if avg_str_len > 60:
            classifications["TEXT"].append(col)
        elif n_unique <= 50 or (uniqueness_ratio <= 0.20 and avg_str_len <= 40):
            classifications["CATEGORICAL"].append(col)
        else:
            classifications["TEXT"].append(col)

    return classifications


# ==============================================================================
# 4. DATA QUALITY AUDITOR
# ==============================================================================
def calculate_data_quality(df: pd.DataFrame, classifications: dict[str, list[str]]) -> dict:
    """Calculates granular and overall data quality metrics."""
    total_rows = len(df)
    total_cols = len(df.columns)
    total_cells = total_rows * total_cols

    missing_cells = df.isnull().sum().sum()
    missing_pct = (missing_cells / total_cells * 100) if total_cells > 0 else 0.0

    duplicate_rows = df.duplicated().sum()
    duplicate_pct = (duplicate_rows / total_rows * 100) if total_rows > 0 else 0.0

    completeness_score = max(0.0, 100.0 - missing_pct)
    uniqueness_score = max(0.0, 100.0 - duplicate_pct)

    overall_quality = round((completeness_score * 0.7) + (uniqueness_score * 0.3), 1)

    column_stats = []
    for col in df.columns:
        col_type = next((k for k, v in classifications.items() if col in v), "UNKNOWN")
        null_cnt = df[col].isnull().sum()
        null_pct = (null_cnt / total_rows * 100) if total_rows > 0 else 0.0
        uniq_cnt = df[col].nunique()

        column_stats.append(
            {
                "Column Name": col,
                "Detected Type": col_type,
                "Native Dtype": str(df[col].dtype),
                "Unique Values": uniq_cnt,
                "Missing Values": null_cnt,
                "Missing %": round(null_pct, 1),
            }
        )

    return {
        "total_rows": total_rows,
        "total_cols": total_cols,
        "missing_cells": missing_cells,
        "missing_pct": round(missing_pct, 1),
        "duplicate_rows": duplicate_rows,
        "duplicate_pct": round(duplicate_pct, 1),
        "completeness_score": round(completeness_score, 1),
        "uniqueness_score": round(uniqueness_score, 1),
        "overall_quality": overall_quality,
        "column_stats": pd.DataFrame(column_stats),
    }


# ==============================================================================
# 5. AUTOMATIC INTELLIGENT CHART SELECTION & SCORING ENGINE
# ==============================================================================
def select_automatic_insights(
    df: pd.DataFrame, classifications: dict[str, list[str]]
) -> list[dict]:
    """Selects and scores the top 4-6 visuals for the immediate dashboard."""
    visual_specs = []

    # Scoring Categorical Columns
    cat_scores = []
    for col in classifications["CATEGORICAL"]:
        n_uniq = df[col].nunique()
        if 2 <= n_uniq <= 20:
            score = 10.0
            col_lower = col.lower()
            if any(kw in col_lower for kw in ["status", "phase", "type", "category", "dept", "department", "region", "priority", "severity"]):
                score += 5.0
            if 3 <= n_uniq <= 8:
                score += 3.0
            cat_scores.append((score, col))

    cat_scores.sort(key=lambda x: x[0], reverse=True)
    top_cats = [c[1] for c in cat_scores]

    # Scoring Date Columns
    date_scores = []
    for col in classifications["DATE"]:
        score = 10.0
        col_lower = col.lower()
        if any(kw in col_lower for kw in ["created", "date", "timestamp", "start", "opened"]):
            score += 5.0
        date_scores.append((score, col))
    date_scores.sort(key=lambda x: x[0], reverse=True)
    top_dates = [d[1] for d in date_scores]

    # Scoring Numeric Columns
    num_scores = []
    for col in classifications["NUMERIC"]:
        score = 10.0
        col_lower = col.lower()
        if any(kw in col_lower for kw in ["amount", "sales", "revenue", "total", "cost", "price", "duration", "score", "qty", "quantity"]):
            score += 5.0
        num_scores.append((score, col))
    num_scores.sort(key=lambda x: x[0], reverse=True)
    top_nums = [n[1] for n in num_scores]

    # 1. Primary Categorical Distribution (Bar Chart)
    if top_cats:
        visual_specs.append(
            {
                "type": "cat_bar",
                "title": f"Distribution by {top_cats[0]}",
                "col": top_cats[0],
                "span": 6,
            }
        )

    # 2. Secondary Categorical Share (Donut Chart)
    if len(top_cats) > 1:
        visual_specs.append(
            {
                "type": "cat_donut",
                "title": f"Share by {top_cats[1]}",
                "col": top_cats[1],
                "span": 6,
            }
        )
    elif top_cats:
        visual_specs.append(
            {
                "type": "cat_donut",
                "title": f"Proportional Share of {top_cats[0]}",
                "col": top_cats[0],
                "span": 6,
            }
        )

    # 3. Date Trend Chart
    if top_dates:
        visual_specs.append(
            {
                "type": "date_trend",
                "title": f"Volume Trend Over Time ({top_dates[0]})",
                "date_col": top_dates[0],
                "cat_col": top_cats[0] if top_cats else None,
                "span": 12,
            }
        )

    # 4. Numeric Metric Breakdown or Distribution
    if top_nums:
        if top_cats:
            visual_specs.append(
                {
                    "type": "num_by_cat",
                    "title": f"Total {top_nums[0]} by {top_cats[0]}",
                    "num_col": top_nums[0],
                    "cat_col": top_cats[0],
                    "span": 6,
                }
            )
        visual_specs.append(
            {
                "type": "num_dist",
                "title": f"Distribution of {top_nums[0]}",
                "num_col": top_nums[0],
                "span": 6 if top_cats else 12,
            }
        )

    return visual_specs[:5]


# ==============================================================================
# 6. PLOTLY CHART BUILDERS (ENTERPRISE THEME)
# ==============================================================================
COLOR_PALETTE = ["#0284C7", "#0D9488", "#6366F1", "#8B5CF6", "#EC4899", "#F59E0B", "#10B981", "#64748B"]


def apply_plotly_enterprise_theme(fig: go.Figure, title: str) -> go.Figure:
    """Applies clean enterprise aesthetic to Plotly figures."""
    fig.update_layout(
        title={"text": f"<b>{title}</b>", "font": {"size": 14, "color": "#0F172A"}},
        margin=dict(l=20, r=20, t=40, b=20),
        paper_bgcolor="rgba(0,0,0,0)",
        plot_bgcolor="rgba(0,0,0,0)",
        font=dict(family="Inter, sans-serif", color="#475569", size=12),
        legend=dict(
            orientation="h",
            yanchor="bottom",
            y=1.02,
            xanchor="right",
            x=1,
            title="",
        ),
        xaxis=dict(
            showgrid=True,
            gridcolor="#F1F5F9",
            zeroline=False,
            showline=True,
            linecolor="#CBD5E1",
        ),
        yaxis=dict(
            showgrid=True,
            gridcolor="#F1F5F9",
            zeroline=False,
            showline=True,
            linecolor="#CBD5E1",
        ),
    )
    return fig


def build_categorical_bar(df: pd.DataFrame, col: str, title: str) -> go.Figure:
    counts = df[col].value_counts().reset_index()
    counts.columns = [col, "Count"]
    counts = counts.head(15)

    fig = px.bar(
        counts,
        x="Count",
        y=col,
        orientation="h",
        text="Count",
        color_discrete_sequence=["#0284C7"],
    )
    fig.update_traces(textposition="outside", marker_radius=4)
    fig.update_layout(yaxis=dict(autorange="reversed"))
    return apply_plotly_enterprise_theme(fig, title)


def build_categorical_donut(df: pd.DataFrame, col: str, title: str) -> go.Figure:
    counts = df[col].value_counts().reset_index()
    counts.columns = [col, "Count"]
    if len(counts) > 7:
        top_6 = counts.iloc[:6]
        other_cnt = counts.iloc[6:]["Count"].sum()
        counts = pd.concat(
            [top_6, pd.DataFrame([{col: "Other", "Count": other_cnt}])],
            ignore_index=True,
        )

    fig = px.pie(
        counts,
        names=col,
        values="Count",
        hole=0.55,
        color_discrete_sequence=COLOR_PALETTE,
    )
    fig.update_traces(textinfo="percent+label")
    return apply_plotly_enterprise_theme(fig, title)


def build_date_trend(
    df: pd.DataFrame, date_col: str, cat_col: str | None, title: str
) -> go.Figure:
    temp_df = df.copy()
    temp_df[date_col] = pd.to_datetime(temp_df[date_col], errors="coerce")
    temp_df = temp_df.dropna(subset=[date_col])

    if temp_df.empty:
        fig = go.Figure()
        fig.add_annotation(text="No valid date data available", showarrow=False)
        return apply_plotly_enterprise_theme(fig, title)

    # Determine dynamic frequency based on date span
    min_d, max_d = temp_df[date_col].min(), temp_df[date_col].max()
    days_span = (max_d - min_d).days

    if days_span <= 30:
        freq, freq_label = "D", "Daily"
    elif days_span <= 180:
        freq, freq_label = "W-MON", "Weekly"
    elif days_span <= 730:
        freq, freq_label = "ME", "Monthly"
    else:
        freq, freq_label = "YE", "Yearly"

    if cat_col and temp_df[cat_col].nunique() <= 8:
        grouped = (
            temp_df.groupby([pd.Grouper(key=date_col, freq=freq), cat_col])
            .size()
            .reset_index(name="Count")
        )
        fig = px.line(
            grouped,
            x=date_col,
            y="Count",
            color=cat_col,
            markers=True,
            color_discrete_sequence=COLOR_PALETTE,
        )
    else:
        grouped = (
            temp_df.groupby(pd.Grouper(key=date_col, freq=freq))
            .size()
            .reset_index(name="Count")
        )
        fig = px.area(
            grouped,
            x=date_col,
            y="Count",
            markers=True,
            color_discrete_sequence=["#0284C7"],
        )
        fig.update_traces(fillcolor="rgba(2, 132, 199, 0.15)")

    return apply_plotly_enterprise_theme(fig, f"{title} ({freq_label})")


def build_num_by_cat(
    df: pd.DataFrame, num_col: str, cat_col: str, title: str
) -> go.Figure:
    grouped = (
        df.groupby(cat_col)[num_col]
        .sum()
        .reset_index()
        .sort_values(by=num_col, ascending=False)
        .head(10)
    )
    fig = px.bar(
        grouped,
        x=cat_col,
        y=num_col,
        text_auto=".2s",
        color_discrete_sequence=["#0D9488"],
    )
    fig.update_traces(textposition="outside")
    return apply_plotly_enterprise_theme(fig, title)


def build_num_distribution(df: pd.DataFrame, num_col: str, title: str) -> go.Figure:
    fig = px.histogram(
        df,
        x=num_col,
        nbins=25,
        marginal="box",
        color_discrete_sequence=["#6366F1"],
    )
    return apply_plotly_enterprise_theme(fig, title)


