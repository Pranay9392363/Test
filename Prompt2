def generate_excel_kpi_report(
    df: pd.DataFrame, classifications: dict[str, list[str]], quality: dict
) -> bytes:
    """Generates a professional multi-sheet Excel workbook with formatted tables and metrics."""
    output = BytesIO()
    wb = openpyxl.Workbook()

    # Style definitions
    font_header = Font(name="Calibri", size=11, bold=True, color="FFFFFF")
    font_title = Font(name="Calibri", size=16, bold=True, color="0F172A")
    fill_navy = PatternFill(
        start_color="1E293B", end_color="1E293B", fill_type="solid"
    )
    fill_accent = PatternFill(
        start_color="F1F5F9", end_color="F1F5F9", fill_type="solid"
    )
    thin_border = Border(
        left=Side(style="thin", color="CBD5E1"),
        right=Side(style="thin", color="CBD5E1"),
        top=Side(style="thin", color="CBD5E1"),
        bottom=Side(style="thin", color="CBD5E1"),
    )

    # Sheet 1: Executive Overview
    ws_ov = wb.active
    ws_ov.title = "Executive Overview"
    ws_ov.views.sheetView[0].showGridLines = True

    ws_ov["A1"] = "ENTERPRISE KPI & DATA QUALITY SUMMARY"
    ws_ov["A1"].font = font_title

    ov_metrics = [
        ("Total Record Count", quality["total_rows"]),
        ("Total Features / Columns", quality["total_cols"]),
        ("Overall Data Quality Score", f"{quality['overall_quality']}%"),
        ("Completeness Score", f"{quality['completeness_score']}%"),
        ("Duplicate Row Count", quality["duplicate_rows"]),
        ("Date Fields Detected", len(classifications["DATE"])),
        ("Categorical Fields Detected", len(classifications["CATEGORICAL"])),
        ("Numeric Fields Detected", len(classifications["NUMERIC"])),
    ]

    ws_ov.cell(row=3, column=1, value="Metric").font = font_header
    ws_ov.cell(row=3, column=1).fill = fill_navy
    ws_ov.cell(row=3, column=2, value="Value").font = font_header
    ws_ov.cell(row=3, column=2).fill = fill_navy

    for idx, (m, v) in enumerate(ov_metrics, start=4):
        ws_ov.cell(row=idx, column=1, value=m).border = thin_border
        cell_v = ws_ov.cell(row=idx, column=2, value=v)
        cell_v.border = thin_border
        cell_v.alignment = Alignment(horizontal="right")

    # Sheet 2: Data Quality Audit
    ws_dq = wb.create_sheet(title="Data Quality Audit")
    ws_dq.views.sheetView[0].showGridLines = True
    dq_df = quality["column_stats"]

    for col_num, header in enumerate(dq_df.columns, 1):
        c = ws_dq.cell(row=1, column=col_num, value=header)
        c.font = font_header
        c.fill = fill_navy

    for r_idx, row in enumerate(dq_df.itertuples(index=False), 2):
        for c_idx, val in enumerate(row, 1):
            c = ws_dq.cell(row=r_idx, column=c_idx, value=val)
            c.border = thin_border

    # Sheet 3: Numeric Field Summary
    if classifications["NUMERIC"]:
        ws_num = wb.create_sheet(title="Numeric Analytics")
        ws_num.views.sheetView[0].showGridLines = True
        num_summary = df[classifications["NUMERIC"]].describe().T.reset_index()
        num_summary.rename(columns={"index": "Numeric Column"}, inplace=True)

        for col_num, header in enumerate(num_summary.columns, 1):
            c = ws_num.cell(row=1, column=col_num, value=header)
            c.font = font_header
            c.fill = fill_navy

        for r_idx, row in enumerate(num_summary.itertuples(index=False), 2):
            for c_idx, val in enumerate(row, 1):
                c = ws_num.cell(
                    row=r_idx,
                    column=c_idx,
                    value=round(val, 2) if isinstance(val, (float, np.floating)) else val,
                )
                c.border = thin_border

    # Sheet 4: Cleaned Data Sample (First 5000 rows max for performance)
    ws_data = wb.create_sheet(title="Data Export")
    ws_data.views.sheetView[0].showGridLines = True
    export_sample = df.head(5000)

    for col_num, header in enumerate(export_sample.columns, 1):
        c = ws_data.cell(row=1, column=col_num, value=header)
        c.font = font_header
        c.fill = fill_navy

    for r_idx, row in enumerate(export_sample.itertuples(index=False), 2):
        for c_idx, val in enumerate(row, 1):
            c = ws_data.cell(row=r_idx, column=c_idx, value=str(val) if pd.isna(val) else val)
            c.border = thin_border

    # Auto-fit Column Widths across all sheets
    for ws in wb.worksheets:
        for col in ws.columns:
            max_len = max(len(str(cell.value or "")) for cell in col)
            col_letter = get_column_letter(col[0].column)
            ws.column_dimensions[col_letter].width = min(max(max_len + 3, 12), 40)

    wb.save(output)
    return output.getvalue()


