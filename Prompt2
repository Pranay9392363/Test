                            f"{filtered_df[selected_num].isnull().sum():,}",
                        ],
                    }
                )
                st.dataframe(stats_df, use_container_width=True, hide_index=True)

            with c2:
                fig = build_num_distribution(
                    filtered_df, selected_num, f"{selected_num} Distribution & Outliers"
