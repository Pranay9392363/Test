    )

    if not uploaded_file:
        st.info("👈 Please upload an Excel or CSV file in the sidebar to generate the interactive dashboard.")
        col1, col2 = st.columns(2)
        with col1:
            st.markdown(
                """
            <div class="section-container">
                <div class="section-title">⚡ Autonomous Capabilities</div>
                <ul>
                    <li><b>Zero Config Required:</b> Upload any file; column types are detected automatically.</li>
                    <li><b>Dynamic KPI Generation:</b> Calculates key metrics based on actual dataset traits.</li>
                    <li><b>Power BI Experience:</b> Real-time visual refresh with bi-directional filters.</li>
                    <li><b>Enterprise Excel Reports:</b> Multi-sheet report export with styled audits.</li>
                </ul>
            </div>
            """,
                unsafe_allow_html=True,
            )
        with col2:
            st.markdown(
                """
            <div class="section-container">
                <div class="section-title">🛡️ Robust Column Classification</div>
                <ul>
                    <li><b>ID Fields:</b> High uniqueness / key naming patterns.</li>
                    <li><b>Dates:</b> Multi-format string & timestamp parsing.</li>
                    <li><b>Categoricals:</b> Unique value counts & cardinality checks.</li>
                    <li><b>Numeric:</b> Aggregations, metrics, and histograms.</li>
                </ul>
            </div>
            """,
                unsafe_allow_html=True,
            )
        return

    file_bytes = uploaded_file.getvalue()
    sheet_name = None

    if uploaded_file.name.lower().endswith((".xlsx", ".xls")):
        try:
            xl = pd.ExcelFile(BytesIO(file_bytes))
            sheets = xl.sheet_names
            if len(sheets) > 1:
                sheet_name = st.sidebar.selectbox("Select Excel Worksheet", sheets, index=0)
            else:
                sheet_name = sheets[0]
        except Exception as e:
            st.error(f"Error reading Excel sheets: {e}")
            return

    with st.spinner("Analyzing dataset structure..."):
        raw_df, error_msg = load_and_clean_data(file_bytes, uploaded_file.name, sheet_name)

    if error_msg or raw_df is None:
        st.error(f"Failed to process file: {error_msg}")
        return

    classifications = classify_columns(raw_df)

    # Sidebar Filter Controls
    st.sidebar.markdown("---")
    st.sidebar.title("🎛️ Dynamic Filters")

    filtered_df = raw_df.copy()
    active_filters = {}
    filterable_cats = classifications["CATEGORICAL"][:5]

    for cat_col in filterable_cats:
        options = sorted([str(x) for x in raw_df[cat_col].dropna().unique()])
        selected = st.sidebar.multiselect(
            f"Filter {cat_col}", options=options, default=[], key=f"sb_{cat_col}"
        )
        if selected:
            active_filters[cat_col] = selected

    for col, vals in active_filters.items():
        filtered_df = filtered_df[filtered_df[col].astype(str).isin(vals)]

    if st.sidebar.button("Reset All Filters", use_container_width=True):
        st.rerun()

    # 1. Executive KPI Cards
    quality_metrics = calculate_data_quality(filtered_df, classifications)

    kpi_cols = st.columns(5)
    with kpi_cols[0]:
        render_kpi_card("Total Records", f"{len(filtered_df):,}", f"of {len(raw_df):,} total")
    with kpi_cols[1]:
        render_kpi_card("Total Columns", len(filtered_df.columns), f"{len(classifications['NUMERIC'])} numeric")
    with kpi_cols[2]:
        render_kpi_card("Categories", len(classifications["CATEGORICAL"]), "detected")
    with kpi_cols[3]:
        render_kpi_card("Date Fields", len(classifications["DATE"]), "detected")
    with kpi_cols[4]:
        render_kpi_card("Quality Score", f"{quality_metrics['overall_quality']}%", f"{quality_metrics['missing_pct']}% missing")

    if classifications["NUMERIC"]:
        st.markdown("<div style='margin-top: 10px;'></div>", unsafe_allow_html=True)
        top_num = classifications["NUMERIC"][0]
        num_series = pd.to_numeric(filtered_df[top_num], errors="coerce")
        num_cols = st.columns(4)
        with num_cols[0]:
            render_kpi_card(f"Total {top_num}", f"{num_series.sum():,.2f}", "Sum")
        with num_cols[1]:
            render_kpi_card(f"Average {top_num}", f"{num_series.mean():,.2f}", "Mean")
        with num_cols[2]:
            render_kpi_card(f"Max {top_num}", f"{num_series.max():,.2f}", "Peak")
        with num_cols[3]:
            render_kpi_card(f"Min {top_num}", f"{num_series.min():,.2f}", "Floor")

    # 2. Automatic Insights Dashboard (Multi-Row Visual Grid)
    st.markdown("<div style='margin-top: 1.5rem;'></div>", unsafe_allow_html=True)
    st.markdown('<div class="section-title">⚡ Automatic Dashboard Insights</div>', unsafe_allow_html=True)

    visual_specs = select_automatic_insights(filtered_df, classifications)

    if not visual_specs:
        st.warning("Could not automatically select high-confidence charts. Use the interactive tabs below.")
    else:
        idx = 0
        while idx < len(visual_specs):
            spec = visual_specs[idx]
            if spec["span"] == 12:
                with st.container():
                    if spec["type"] == "date_trend":
                        fig = build_date_trend(
                            filtered_df, spec["date_col"], spec["cat_col"], spec["title"]
                        )
                    elif spec["type"] == "scatter_num":
                        fig = build_scatter_num(
                            filtered_df, spec["num_x"], spec["num_y"], spec["cat_col"], spec["title"]
                        )
                    elif spec["type"] == "pareto_cat":
                        fig = build_pareto_cat(filtered_df, spec["col"], spec["title"])
                    st.plotly_chart(fig, use_container_width=True)
                idx += 1
            else:
                c1, c2 = st.columns(2)
                with c1:
                    if spec["type"] == "cat_bar":
                        fig = build_categorical_bar(filtered_df, spec["col"], spec["title"])
                    elif spec["type"] == "cat_donut":
                        fig = build_categorical_donut(filtered_df, spec["col"], spec["title"])
                    elif spec["type"] == "cumulative_trend":
                        fig = build_cumulative_trend(filtered_df, spec["date_col"], spec["title"])
                    elif spec["type"] == "pareto_cat":
                        fig = build_pareto_cat(filtered_df, spec["col"], spec["title"])
                    elif spec["type"] == "num_by_cat":
                        fig = build_num_by_cat(
                            filtered_df, spec["num_col"], spec["cat_col"], spec["title"]
                        )
                    elif spec["type"] == "num_dist":
                        fig = build_num_distribution(filtered_df, spec["num_col"], spec["title"])
                    st.plotly_chart(fig, use_container_width=True)

                idx += 1
                if idx < len(visual_specs) and visual_specs[idx]["span"] == 6:
                    spec2 = visual_specs[idx]
                    with c2:
                        if spec2["type"] == "cat_bar":
                            fig2 = build_categorical_bar(filtered_df, spec2["col"], spec2["title"])
                        elif spec2["type"] == "cat_donut":
                            fig2 = build_categorical_donut(filtered_df, spec2["col"], spec2["title"])
                        elif spec2["type"] == "cumulative_trend":
                            fig2 = build_cumulative_trend(filtered_df, spec2["date_col"], spec2["title"])
                        elif spec2["type"] == "pareto_cat":
                            fig2 = build_pareto_cat(filtered_df, spec2["col"], spec2["title"])
                        elif spec2["type"] == "num_by_cat":
                            fig2 = build_num_by_cat(
                                filtered_df, spec2["num_col"], spec2["cat_col"], spec2["title"]
                            )
                        elif spec2["type"] == "num_dist":
                            fig2 = build_num_distribution(filtered_df, spec2["num_col"], spec2["title"])
                        st.plotly_chart(fig2, use_container_width=True)
                    idx += 1

    # 3. Interactive Tabs
    st.markdown("<div style='margin-top: 1.5rem;'></div>", unsafe_allow_html=True)
    st.markdown('<div class="section-title">🔍 Detailed Interactive Analysis</div>', unsafe_allow_html=True)

    tab_dist, tab_trends, tab_num, tab_quality, tab_explorer = st.tabs(
        [
            "📊 Distribution",
            "📈 Trends",
            "🔢 Numeric Metrics",
            "🛡️ Data Quality",
            "📋 Data Explorer",
        ]
    )

    with tab_dist:
        if classifications["CATEGORICAL"]:
            c1, c2 = st.columns([1, 2])
            with c1:
                selected_cat = st.selectbox(
                    "Select Categorical Field", classifications["CATEGORICAL"], key="dist_sel"
                )
                chart_type = st.radio("Chart Type", ["Bar Chart", "Donut Chart", "Pareto Chart"], key="dist_type")

                dist_table = filtered_df[selected_cat].astype(str).value_counts(dropna=False).reset_index()
                dist_table.columns = [selected_cat, "Count"]
                dist_table["Percentage"] = (
                    dist_table["Count"] / dist_table["Count"].sum() * 100
                ).round(1).astype(str) + "%"
                st.dataframe(dist_table, use_container_width=True, hide_index=True)

            with c2:
                if chart_type == "Bar Chart":
                    fig = build_categorical_bar(
                        filtered_df, selected_cat, f"{selected_cat} Distribution"
                    )
                elif chart_type == "Donut Chart":
                    fig = build_categorical_donut(
                        filtered_df, selected_cat, f"{selected_cat} Share"
