                else:
                    fig = build_pareto_cat(
                        filtered_df, selected_cat, f"{selected_cat} Pareto Analysis"
                    )
                st.plotly_chart(fig, use_container_width=True)
        else:
            st.info("No categorical columns detected in this dataset.")

    with tab_trends:
        if classifications["DATE"]:
            c1, c2 = st.columns([1, 2])
            with c1:
                selected_date = st.selectbox(
                    "Select Date Field", classifications["DATE"], key="trend_date_sel"
                )
                breakdown_cat = st.selectbox(
                    "Optional Category Breakdown",
                    [None] + classifications["CATEGORICAL"],
                    key="trend_cat_sel",
                )
                trend_mode = st.radio("Trend Type", ["Standard Trend", "Cumulative Growth"], key="trend_mode")
            with c2:
                if trend_mode == "Cumulative Growth":
                    fig = build_cumulative_trend(filtered_df, selected_date, f"Cumulative Growth Over Time ({selected_date})")
                else:
                    fig = build_date_trend(
                        filtered_df,
                        selected_date,
                        breakdown_cat,
                        f"Trend Over Time by {selected_date}",
                    )
                st.plotly_chart(fig, use_container_width=True)
        else:
            st.info("No date columns detected in this dataset.")

    with tab_num:
        if classifications["NUMERIC"]:
            c1, c2 = st.columns([1, 2])
            with c1:
                selected_num = st.selectbox(
                    "Select Numeric Field", classifications["NUMERIC"], key="num_sel"
                )
