def render_kpi_card(label: str, value: str | int | float, subtext: str = ""):
    st.markdown(
        f"""
        <div class="kpi-card">
            <div class="kpi-label">{label}</div>
            <div class="kpi-value">{value}</div>
            <div class="kpi-subtext">{subtext}</div>
        </div>
        """,
        unsafe_allow_html=True,
    )


# ==============================================================================
# 9. MAIN APPLICATION CONTROLLER
# ==============================================================================
def main():
    # --------------------------------------------------------------------------
    # HEADER BANNER
    # --------------------------------------------------------------------------
    st.markdown(
        """
        <div class="enterprise-header">
            <h1>📊 Enterprise KPI & Analytics Dashboard</h1>
            <p>Automated Dataset Intelligence, Visualizations & Data Quality Audit</p>
        </div>
        """,
        unsafe_allow_html=True,
    )

    # --------------------------------------------------------------------------
    # SIDEBAR: FILE UPLOAD & CONFIGURATION
    # --------------------------------------------------------------------------
    st.sidebar.title("📁 Data Source Setup")
    uploaded_file = st.sidebar.file_uploader(
        "Upload Dataset (.xlsx, .xls, .csv)", type=["xlsx", "xls", "csv"]
    )

    if not uploaded_file:
        # Welcome & Instructions Area
        st.info("👈 Please upload an Excel or CSV file in the sidebar to generate the interactive dashboard.")

        col1, col2 = st.columns(2)
        with col1:
            st.markdown(
                """
            <div class="section-container">
                <div class="section-title">⚡ Autonomous Capabilities</div>
                <ul>
                    <li><b>Zero Config Required:</b> Upload any file; column types are detected automatically.</li>
                    <li><b>Dynamic KPI Generation:</b> Calculates key parameters based on actual dataset traits.</li>
                    <li><b>Power BI Experience:</b> Real-time visual refresh with bi-directional filters.</li>
                    <li><b>Enterprise Excel Reports:</b> Multi-sheet report export with styled audits.</li>
                </ul>
            </div>
            """,
                unsafe_allow_html=True,
            )
        with col2:
            st.markdown(
                """
            <div class="section-container">
                <div class="section-title">🛡️ Robust Column Classification</div>
                <ul>
                    <li><b>ID Fields:</b> High uniqueness / key naming patterns.</li>
                    <li><b>Dates:</b> Multi-format string & timestamp parsing.</li>
                    <li><b>Categoricals:</b> Unique value counts & cardinality checks.</li>
                    <li><b>Numeric:</b> Aggregations, metrics, and histograms.</li>
                </ul>
            </div>
            """,
                unsafe_allow_html=True,
            )
        return

    # Handle Excel Sheet Selection
    file_bytes = uploaded_file.getvalue()
    sheet_name = None

    if uploaded_file.name.endswith((".xlsx", ".xls")):
        try:
            xl = pd.ExcelFile(BytesIO(file_bytes))
            sheets = xl.sheet_names
            if len(sheets) > 1:
                sheet_name = st.sidebar.selectbox("Select Excel Worksheet", sheets, index=0)
            else:
                sheet_name = sheets[0]
        except Exception as e:
            st.error(f"Error reading Excel sheets: {e}")
            return

    # Load and Clean
    with st.spinner("Analyzing dataset structure..."):
        raw_df, error_msg = load_and_clean_data(file_bytes, uploaded_file.name, sheet_name)

    if error_msg or raw_df is None:
        st.error(f"Failed to process file: {error_msg}")
        return

    # Classify Columns
    classifications = classify_columns(raw_df)

    # --------------------------------------------------------------------------
    # SIDEBAR & TOP INTERACTIVE FILTER SYSTEM
    # --------------------------------------------------------------------------
    st.sidebar.markdown("---")
    st.sidebar.title("🎛️ Dynamic Filters")

    # Track filter states
    filtered_df = raw_df.copy()

    # Create Filter Controls for Categorical Columns (Limit to top 5 categories)
    active_filters = {}
    filterable_cats = classifications["CATEGORICAL"][:5]

    for cat_col in filterable_cats:
        options = sorted(list(raw_df[cat_col].dropna().unique()))
        selected = st.sidebar.multiselect(
            f"Filter {cat_col}", options=options, default=[], key=f"sb_{cat_col}"
        )
        if selected:
            active_filters[cat_col] = selected

    # Apply Sidebar Filters to DataFrame
    for col, vals in active_filters.items():
        filtered_df = filtered_df[filtered_df[col].isin(vals)]

    if st.sidebar.button("Reset All Filters", use_container_width=True):
        st.rerun()

    # --------------------------------------------------------------------------
    # 1. EXECUTIVE KPI CARDS (ABOVE FILTERS)
    # --------------------------------------------------------------------------
    quality_metrics = calculate_data_quality(filtered_df, classifications)

    kpi_cols = st.columns(5)
    with kpi_cols[0]:
        render_kpi_card("Total Records", f"{len(filtered_df):,}", f"of {len(raw_df):,} total")
    with kpi_cols[1]:
        render_kpi_card("Total Columns", len(filtered_df.columns), f"{len(classifications['NUMERIC'])} numeric")
    with kpi_cols[2]:
        render_kpi_card("Categories", len(classifications["CATEGORICAL"]), "detected")
    with kpi_cols[3]:
        render_kpi_card("Date Fields", len(classifications["DATE"]), "detected")
    with kpi_cols[4]:
        render_kpi_card("Quality Score", f"{quality_metrics['overall_quality']}%", f"{quality_metrics['missing_pct']}% missing")

    # Dynamic Numeric Metric Cards
    if classifications["NUMERIC"]:
        st.markdown("<div style='margin-top: 10px;'></div>", unsafe_allow_html=True)
        top_num = classifications["NUMERIC"][0]
        num_cols = st.columns(4)
        with num_cols[0]:
            render_kpi_card(f"Total {top_num}", f"{filtered_df[top_num].sum():,.2f}", "Sum")
        with num_cols[1]:
            render_kpi_card(f"Average {top_num}", f"{filtered_df[top_num].mean():,.2f}", "Mean")
        with num_cols[2]:
            render_kpi_card(f"Max {top_num}", f"{filtered_df[top_num].max():,.2f}", "Peak")
        with num_cols[3]:
            render_kpi_card(f"Min {top_num}", f"{filtered_df[top_num].min():,.2f}", "Floor")

    # --------------------------------------------------------------------------
    # 2. AUTOMATIC INSIGHTS DASHBOARD (AUTOMATIC VISUALIZATIONS)
    # --------------------------------------------------------------------------
    st.markdown("<div style='margin-top: 1.5rem;'></div>", unsafe_allow_html=True)
    st.markdown('<div class="section-title">⚡ Automatic Dashboard Insights</div>', unsafe_allow_html=True)

    visual_specs = select_automatic_insights(filtered_df, classifications)

    if not visual_specs:
        st.warning("Could not automatically select high-confidence charts. Use the interactive tabs below.")
    else:
        # Render charts in dynamic grid layouts
        idx = 0
        while idx < len(visual_specs):
            spec = visual_specs[idx]

            # Full Width Chart
            if spec["span"] == 12:
                with st.container():
                    if spec["type"] == "date_trend":
                        fig = build_date_trend(
                            filtered_df, spec["date_col"], spec["cat_col"], spec["title"]
                        )
                        st.plotly_chart(fig, use_container_width=True)
                idx += 1
            # Pair of Half Width Charts
            else:
                c1, c2 = st.columns(2)
                with c1:
                    if spec["type"] == "cat_bar":
                        fig = build_categorical_bar(filtered_df, spec["col"], spec["title"])
                    elif spec["type"] == "cat_donut":
                        fig = build_categorical_donut(filtered_df, spec["col"], spec["title"])
                    elif spec["type"] == "num_by_cat":
                        fig = build_num_by_cat(
                            filtered_df, spec["num_col"], spec["cat_col"], spec["title"]
                        )
                    elif spec["type"] == "num_dist":
                        fig = build_num_distribution(filtered_df, spec["num_col"], spec["title"])
                    st.plotly_chart(fig, use_container_width=True)

                idx += 1
                if idx < len(visual_specs) and visual_specs[idx]["span"] == 6:
                    spec2 = visual_specs[idx]
                    with c2:
                        if spec2["type"] == "cat_bar":
                            fig2 = build_categorical_bar(filtered_df, spec2["col"], spec2["title"])
                        elif spec2["type"] == "cat_donut":
                            fig2 = build_categorical_donut(filtered_df, spec2["col"], spec2["title"])
                        elif spec2["type"] == "num_by_cat":
                            fig2 = build_num_by_cat(
                                filtered_df, spec2["num_col"], spec2["cat_col"], spec2["title"]
                            )
                        elif spec2["type"] == "num_dist":
                            fig2 = build_num_distribution(filtered_df, spec2["num_col"], spec2["title"])
                        st.plotly_chart(fig2, use_container_width=True)
                    idx += 1

    # --------------------------------------------------------------------------
    # 3. INTERACTIVE ANALYSIS & DATA EXPLORER TABS
    # --------------------------------------------------------------------------
    st.markdown("<div style='margin-top: 1.5rem;'></div>", unsafe_allow_html=True)
    st.markdown('<div class="section-title">🔍 Detailed Interactive Analysis</div>', unsafe_allow_html=True)

    tab_dist, tab_trends, tab_num, tab_quality, tab_explorer = st.tabs(
        [
            "📊 Distribution",
            "📈 Trends",
            "🔢 Numeric Metrics",
            "🛡️ Data Quality",
            "📋 Data Explorer",
        ]
    )

    # --- TAB 1: DISTRIBUTION ---
    with tab_dist:
        if classifications["CATEGORICAL"]:
            c1, c2 = st.columns([1, 2])
            with c1:
                selected_cat = st.selectbox(
                    "Select Categorical Field", classifications["CATEGORICAL"], key="dist_sel"
                )
                chart_type = st.radio("Chart Type", ["Bar Chart", "Donut Chart"], key="dist_type")

                # Distribution Summary Table
                dist_table = filtered_df[selected_cat].value_counts(dropna=False).reset_index()
                dist_table.columns = [selected_cat, "Count"]
                dist_table["Percentage"] = (
                    dist_table["Count"] / dist_table["Count"].sum() * 100
                ).round(1).astype(str) + "%"
                st.dataframe(dist_table, use_container_width=True, hide_index=True)

            with c2:
                if chart_type == "Bar Chart":
                    fig = build_categorical_bar(
                        filtered_df, selected_cat, f"{selected_cat} Distribution"
                    )
                else:
                    fig = build_categorical_donut(
                        filtered_df, selected_cat, f"{selected_cat} Share"
                    )
                st.plotly_chart(fig, use_container_width=True)
        else:
            st.info("No categorical columns detected in this dataset.")

    # --- TAB 2: TRENDS ---
    with tab_trends:
        if classifications["DATE"]:
            c1, c2 = st.columns([1, 2])
            with c1:
                selected_date = st.selectbox(
                    "Select Date Field", classifications["DATE"], key="trend_date_sel"
                )
                breakdown_cat = st.selectbox(
                    "Optional Category Breakdown",
                    [None] + classifications["CATEGORICAL"],
                    key="trend_cat_sel",
                )
            with c2:
                fig = build_date_trend(
                    filtered_df,
                    selected_date,
                    breakdown_cat,
                    f"Trend Over Time by {selected_date}",
                )
                st.plotly_chart(fig, use_container_width=True)
        else:
            st.info("No date columns detected in this dataset.")

    # --- TAB 3: NUMERIC METRICS ---
    with tab_num:
        if classifications["NUMERIC"]:
            c1, c2 = st.columns([1, 2])
            with c1:
                selected_num = st.selectbox(
                    "Select Numeric Field", classifications["NUMERIC"], key="num_sel"
                )
                s = filtered_df[selected_num].dropna()

                stats_df = pd.DataFrame(
                    {
                        "Statistic": [
                            "Sum",
                            "Mean",
                            "Median",
                            "Std Dev",
                            "Min",
                            "Max",
                            "Count",
                            "Null Count",
                        ],
                        "Value": [
                            f"{s.sum():,.2f}",
                            f"{s.mean():,.2f}",
                            f"{s.median():,.2f}",
                            f"{s.std():,.2f}",
                            f"{s.min():,.2f}",
                            f"{s.max():,.2f}",
                            f"{len(s):,}",
                            f"{filtered_df[selected_num].isnull().sum():,}",
                        ],
                    }
                )
                st.dataframe(stats_df, use_container_width=True, hide_index=True)

            with c2:
                fig = build_num_distribution(
                    filtered_df, selected_num, f"{selected_num} Distribution & Outliers"
                )
                st.plotly_chart(fig, use_container_width=True)
        else:
            st.info("No numeric columns detected in this dataset.")

    # --- TAB 4: DATA QUALITY AUDIT ---
    with tab_quality:
        st.markdown("##### Column Quality Breakdown")
        st.dataframe(
            quality_metrics["column_stats"],
            use_container_width=True,
            hide_index=True,
        )

    # --- TAB 5: DATA EXPLORER ---
    with tab_explorer:
        c1, c2 = st.columns([3, 1])
        with c1:
            search_query = st.text_input("🔍 Search within active filtered records", "")
        with c2:
            st.markdown(
                f"<div style='padding-top: 1.8rem; font-weight:600;'>Showing {len(filtered_df):,} rows</div>",
                unsafe_allow_html=True,
            )

        explorer_df = filtered_df.copy()
        if search_query:
            mask = np.column_stack(
                [
                    explorer_df[col]
                    .astype(str)
                    .str.contains(search_query, case=False, na=False)
                    for col in explorer_df.columns
                ]
            )
            explorer_df = explorer_df[mask.any(axis=1)]

        st.dataframe(explorer_df, use_container_width=True, hide_index=True)

    # --------------------------------------------------------------------------
    # 4. EXPORT & REPORT DOWNLOAD AREA
    # --------------------------------------------------------------------------
    st.markdown("<div style='margin-top: 1.5rem;'></div>", unsafe_allow_html=True)
    st.markdown('<div class="section-title">📥 Export & Reports</div>', unsafe_allow_html=True)

    exp_col1, exp_col2 = st.columns(2)

    with exp_col1:
        excel_data = generate_excel_kpi_report(filtered_df, classifications, quality_metrics)
        st.download_button(
            label="📊 Download Enterprise KPI Excel Report (.xlsx)",
            data=excel_data,
            file_name="Enterprise_KPI_Report.xlsx",
            mime="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            use_container_width=True,
        )

    with exp_col2:
        csv_data = filtered_df.to_csv(index=False).encode("utf-8")
        st.download_button(
            label="📄 Download Filtered Dataset (.csv)",
            data=csv_data,
            file_name="filtered_dataset.csv",
            mime="text/csv",
            use_container_width=True,
        )


if __name__ == "__main__":
    main()
